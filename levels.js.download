  // ------------------------------------------------------------
  // Validation: fail loudly at boot instead of mysteriously at
  // room 8. Checks size, allowed characters, spawn and exit.
  // ------------------------------------------------------------
  TD.validateLevels = function () {
    var ALLOWED = '#=.~c^vxsShPD';
    TD.LEVELS.forEach(function (lvl, idx) {
      if (lvl.map.length !== TD.ROOM_H) {
        throw new Error('Level ' + (idx + 1) + ': expected ' + TD.ROOM_H +
          ' rows, got ' + lvl.map.length);
      }
      var spawns = 0, doors = 0;
      lvl.map.forEach(function (row, r) {
        if (row.length !== TD.ROOM_W) {
          throw new Error('Level ' + (idx + 1) + ' row ' + r +
            ': expected ' + TD.ROOM_W + ' cols, got ' + row.length);
        }
        for (var c = 0; c < row.length; c++) {
          var ch = row[c];
          if (ALLOWED.indexOf(ch) === -1) {
            throw new Error('Level ' + (idx + 1) + ' row ' + r +
              ' col ' + c + ': unknown tile "' + ch + '"');
          }
          if (ch === 'P') spawns++;
          if (ch === 'D') doors++;
        }
      });
      var revealsDoor = (lvl.traps || []).some(function (t) {
        return (t.type === 'fakedoor' && t.reveal) ||
               (t.type === 'movedoor' && t.to);
      });
      if (spawns !== 1) {
        throw new Error('Level ' + (idx + 1) + ': needs exactly 1 spawn, has ' + spawns);
      }
      if (doors + (revealsDoor ? 1 : 0) < 1) {
        throw new Error('Level ' + (idx + 1) + ': has no exit');
      }
      if (!lvl.name || !lvl.name.it || !lvl.name.en) {
        throw new Error('Level ' + (idx + 1) + ': name needs it and en');
      }
      if (lvl.tip && (!lvl.tip.it || !lvl.tip.en)) {
        throw new Error('Level ' + (idx + 1) + ': tip needs it and en');
      }
    });
    return true;
  };

})(window.TD);
