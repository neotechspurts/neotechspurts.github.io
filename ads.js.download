/* ============================================================
   Trap Dungeons 2 - ads.js
   Rewarded ads, done politely. Two pieces:

   TD.Ads        provider layer. Auto-detects the GamePix SDK
                 (window.GamePix, promise based) and falls back
                 to a built-in mock ad for local development.
                 Force one with ?ads=gamepix|mock|off.
                 The game registers pause/resume hooks; the ad
                 layer never touches game internals directly.

   TD.AdDirector the brain. Watches deaths and time stuck in the
                 current room, computes a frustration score and
                 decides IF an offer is worth showing, WHICH
                 reward fits the room (reveal the lies vs skip),
                 and WHEN to shut up: cooldown between offers,
                 session cap, exponential backoff every time the
                 player declines, never in the final room (no
                 spoiling the last gag), reveal only in rooms
                 that actually contain lies, skip capped per run.

   The game stays 100% completable without watching anything,
   and best times/deaths are only saved on runs with zero skips.
   ============================================================ */
'use strict';

(function (TD) {

  /* ------------------------------------------------------------
     Provider layer
     ------------------------------------------------------------ */
  TD.Ads = {
    providerName: 'none',
    provider: null,
    busy: false,
    hooks: { onPause: null, onResume: null },
    log: [],
    onEvent: null,        // optional analytics callback (name, data)
    _impls: {},

    register: function (name, impl) { this._impls[name] = impl; },

    init: function () {
      var forced = null;
      try {
        var m = /[?&]ads=(gamepix|mock|off)\b/.exec(window.location.search || '');
        if (m) forced = m[1];
      } catch (e) { /* ignore */ }

      var name;
      if (forced) {
        name = forced;
      } else if (typeof window.GamePix !== 'undefined') {
        name = 'gamepix';
      } else {
        name = 'mock';
      }

      try {
        TD.AdDirector._interOff = /[?&]inter=off\b/.test(window.location.search || '');
      } catch (e) { /* ignore */ }

      this.providerName = name;
      this.provider = this._impls[name] || null;
      if (this.provider && this.provider.init) this.provider.init();
      this._emit('ads_init', { provider: name });
    },

    available: function () {
      if (!this.provider || this.busy) return false;
      try { return !!this.provider.available(); }
      catch (e) { return false; }
    },

    lastAdAt: 0,           // any full screen ad, reward or interstitial

    // Shows a rewarded ad. done(success) fires exactly once.
    show: function (done) {
      this._run('reward', done);
    },

    // Shows an interstitial. done(shown) fires exactly once and the
    // game continues either way: pacing lives in the AdDirector.
    interstitial: function (done) {
      this._run('inter', done);
    },

    _run: function (kind, done) {
      var self = this;
      var fn = kind === 'inter' ? 'interstitial' : 'show';
      if (this.busy || !this.provider || !this.provider[fn]) { done(false); return; }
      this.busy = true;
      this.lastAdAt = Date.now() / 1000;
      this._emit('ad_start', { provider: this.providerName, kind: kind });
      if (this.hooks.onPause) this.hooks.onPause();

      var finished = false;
      function finish(success) {
        if (finished) return;
        finished = true;
        self.busy = false;
        self.lastAdAt = Date.now() / 1000;
        if (self.hooks.onResume) self.hooks.onResume();
        if (kind === 'inter') {
          self._emit(success ? 'inter_done' : 'inter_fail', { provider: self.providerName });
        } else {
          self._emit(success ? 'ad_reward' : 'ad_dismiss', { provider: self.providerName });
        }
        done(!!success);
      }

      // Whatever the SDK does, the game must come back.
      var guard = setTimeout(function () { finish(false); }, 60000);

      try {
        this.provider[fn](function (success) {
          clearTimeout(guard);
          finish(success);
        });
      } catch (e) {
        clearTimeout(guard);
        this._emit('ad_error', { message: String(e), kind: kind });
        finish(false);
      }
    },

    _emit: function (name, data) {
      var ev = { t: Date.now(), name: name, data: data || {} };
      this.log.push(ev);
      if (this.log.length > 60) this.log.shift();
      if (this.onEvent) {
        try { this.onEvent(name, ev.data); } catch (e) { /* analytics must not break play */ }
      }
    }
  };

  /* ---------------- provider: none (ads disabled) ---------------- */
  TD.Ads.register('off', {
    available: function () { return false; },
    show: function (done) { done(false); },
    interstitial: function (done) { done(false); }
  });

  /* ---------------- provider: GamePix SDK v3 ----------------
     Official API, verified at runtime against
     integration.gamepix.com/sdk/v3/gamepix.sdk.js:
       GamePix.rewardAd()       -> Promise<{ success: boolean }>
       GamePix.interstitialAd() -> Promise
     The reward is granted only on success === true: a dismissed
     video must never pay (Google rewarded ads policy). */
  TD.Ads.register('gamepix', {
    available: function () {
      return !!(window.GamePix && typeof window.GamePix.rewardAd === 'function');
    },
    show: function (done) {
      var result = window.GamePix.rewardAd();
      if (result && typeof result.then === 'function') {
        result.then(function (res) {
          done(!!(res && res.success));
        }, function () { done(false); });
      } else {
        done(false);
      }
    },
    interstitial: function (done) {
      var gp = window.GamePix;
      if (!gp || typeof gp.interstitialAd !== 'function') { done(false); return; }
      var result = gp.interstitialAd();
      if (result && typeof result.then === 'function') {
        result.then(function () { done(true); }, function () { done(false); });
      } else {
        done(true);
      }
    }
  });

  /* ---------------- provider: mock (development) ----------------
     A full screen fake ad with a countdown, a claim button at the
     end and an early-skip that pays nothing, so both outcomes are
     testable offline. ?adnofill=1 simulates an empty ad inventory. */
  TD.Ads.register('mock', {
    duration: 5,
    _noFill: false,

    init: function () {
      try {
        this._noFill = /[?&]adnofill=1\b/.test(window.location.search || '');
      } catch (e) { /* ignore */ }
    },

    available: function () { return !this._noFill && !!document.body; },

    show: function (done) {
      var dur = this.duration;
      var overlay = document.createElement('div');
      overlay.id = 'ad-overlay';
      overlay.innerHTML =
        '<div class="ad-box">' +
        '  <div class="ad-tag">' + TD.t('adMock') + '</div>' +
        '  <div class="ad-art"><span>TRAP<br>AD 2</span></div>' +
        '  <div class="ad-bar"><div class="ad-bar-fill"></div></div>' +
        '  <button class="ad-claim" disabled>' + TD.t('adClose') + '</button>' +
        '  <button class="ad-skip">' + TD.t('adSkipX') + '</button>' +
        '</div>';
      document.body.appendChild(overlay);

      var fill = overlay.querySelector('.ad-bar-fill');
      var claim = overlay.querySelector('.ad-claim');
      var skip = overlay.querySelector('.ad-skip');
      var t0 = Date.now();
      var timer = setInterval(function () {
        var k = Math.min(1, (Date.now() - t0) / (dur * 1000));
        fill.style.width = (k * 100).toFixed(1) + '%';
        if (k >= 1) {
          clearInterval(timer);
          claim.disabled = false;
          claim.classList.add('ready');
        }
      }, 100);

      function close(success) {
        clearInterval(timer);
        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
        done(success);
      }
      claim.addEventListener('click', function () {
        if (!claim.disabled) close(true);
      });
      skip.addEventListener('click', function () { close(false); });
    },

    // Interstitials carry no reward: the bar runs, then the close
    // button appears. Closing always counts as shown.
    interstitial: function (done) {
      var dur = 2.5;
      var overlay = document.createElement('div');
      overlay.id = 'ad-overlay';
      overlay.innerHTML =
        '<div class="ad-box">' +
        '  <div class="ad-tag">' + TD.t('adMockInter') + '</div>' +
        '  <div class="ad-art"><span>TRAP<br>AD 2</span></div>' +
        '  <div class="ad-bar"><div class="ad-bar-fill"></div></div>' +
        '  <button class="ad-claim" disabled>' + TD.t('adClose') + '</button>' +
        '</div>';
      document.body.appendChild(overlay);

      var fill = overlay.querySelector('.ad-bar-fill');
      var claim = overlay.querySelector('.ad-claim');
      var t0 = Date.now();
      var timer = setInterval(function () {
        var k = Math.min(1, (Date.now() - t0) / (dur * 1000));
        fill.style.width = (k * 100).toFixed(1) + '%';
        if (k >= 1) {
          clearInterval(timer);
          claim.disabled = false;
          claim.classList.add('ready');
        }
      }, 100);
      claim.addEventListener('click', function () {
        if (claim.disabled) return;
        clearInterval(timer);
        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
        done(true);
      });
    }
  });

  /* ------------------------------------------------------------
     The director
     ------------------------------------------------------------ */
  TD.AdDirector = {
    enabled: false,        // only easy mode turns the director on
    cfg: {
      revealScore: 5,        // frustration needed for a reveal offer
      skipScore: 11,         // frustration needed for a skip offer
      timeWeight: 1 / 25,    // 25 seconds stuck = 1 death worth
      cooldown: 75,          // seconds between offers
      sessionCap: 5,         // max offers per session
      skipCap: 2,            // max skips per run
      declineBackoff: 1.6,   // threshold multiplier on "no thanks"
      ignoreBackoff: 1.25,   // softer multiplier when just ignored
      toastSeconds: 7
    },

    // Interstitial pacing, after Google's placement rules: only at
    // natural breaks, frequency capped, never right after another
    // full screen ad, never in the opening minute of a session.
    inter: {
      minGap: 120,           // seconds between interstitials
      gapAfterAnyAd: 90,     // distance from ANY full screen ad
      minSession: 45,        // no interstitials in the first moments
      sessionCap: 4
    },
    interShown: 0,
    _lastInterAt: -1e9,
    _interOff: false,

    deathsInRoom: 0,
    timeInRoom: 0,
    sessionTime: 0,
    lastOfferAt: -1e9,
    offersShown: 0,
    skipsUsed: 0,
    mult: 1,

    // A natural break arrived (act transition, game over screen,
    // run finished). Decides whether an interstitial fits, shows
    // it if so, and ALWAYS calls next() exactly once.
    maybeInterstitial: function (reason, next) {
      var A = TD.Ads;
      var now = Date.now() / 1000;
      var ok =
        !this._interOff &&
        A.provider && A.providerName !== 'off' && !A.busy &&
        this.sessionTime >= this.inter.minSession &&
        this.interShown < this.inter.sessionCap &&
        (now - this._lastInterAt) >= this.inter.minGap &&
        (!A.lastAdAt || (now - A.lastAdAt) >= this.inter.gapAfterAnyAd);

      if (!ok) {
        TD.Ads._emit('inter_skip', { reason: reason });
        next(false);
        return;
      }

      var self = this;
      this._lastInterAt = now;
      this.interShown++;
      TD.Ads._emit('inter_slot', { reason: reason, count: this.interShown });
      A.interstitial(function () { next(true); });
    },

    resetRun: function () {
      this.skipsUsed = 0;
      this.deathsInRoom = 0;
      this.timeInRoom = 0;
    },

    onRoomEnter: function (fresh) {
      if (fresh) {
        this.deathsInRoom = 0;
        this.timeInRoom = 0;
      }
    },

    tick: function (dt) {
      this.timeInRoom += dt;
      this.sessionTime += dt;
    },

    frustration: function () {
      return this.deathsInRoom + this.timeInRoom * this.cfg.timeWeight;
    },

    // The room "has lies" if a reveal would actually show something.
    roomHasLies: function (def) {
      for (var r = 0; r < def.map.length; r++) {
        if (/[~xc]/.test(def.map[r])) return true;
      }
      return (def.traps || []).some(function (t) {
        return t.type === 'fakedoor' || t.type === 'dropspike' ||
               t.type === 'popspike' || t.type === 'tracker' ||
               t.type === 'movedoor' || t.type === 'trapheart' ||
               t.type === 'fakespring' || t.type === 'jumpspikes';
      });
    },

    // Easy mode lowers the bar and shortens the cooldown.
    setAssist: function (on) {
      if (!this._baseCfg) {
        this._baseCfg = { revealScore: this.cfg.revealScore,
          skipScore: this.cfg.skipScore, cooldown: this.cfg.cooldown };
      }
      if (on) {
        this.cfg.revealScore = 3;
        this.cfg.skipScore = 7;
        this.cfg.cooldown = 45;
      } else {
        this.cfg.revealScore = this._baseCfg.revealScore;
        this.cfg.skipScore = this._baseCfg.skipScore;
        this.cfg.cooldown = this._baseCfg.cooldown;
      }
    },

    // Called after every death. Returns an offer or null.
    onDeath: function (game) {
      this.deathsInRoom++;
      if (!this.enabled) return null;

      var def = game.room.def;
      if (def.final) return null;                          // never spoil the finale
      if (this.offersShown >= this.cfg.sessionCap) return null;
      if (this.sessionTime - this.lastOfferAt < this.cfg.cooldown) return null;
      if (!TD.Ads.available()) return null;

      var f = this.frustration();
      var memory = game.memoryByRoom[game.roomIndex] || {};
      var canReveal = this.roomHasLies(def) && !memory.revealed;
      var canSkip = this.skipsUsed < this.cfg.skipCap;

      if (canReveal && f >= this.cfg.revealScore * this.mult) {
        return this._offer('reveal');
      }
      if (canSkip && f >= this.cfg.skipScore * this.mult) {
        return this._offer('skip');
      }
      return null;
    },

    _offer: function (type) {
      this.lastOfferAt = this.sessionTime;
      this.offersShown++;
      TD.Ads._emit('offer_shown', { type: type, frustration: this.frustration().toFixed(1) });
      return { type: type };
    },

    accepted: function (type) {
      TD.Ads._emit('offer_accept', { type: type });
    },

    declined: function (type) {
      this.mult *= this.cfg.declineBackoff;
      TD.Ads._emit('offer_decline', { type: type });
    },

    ignored: function (type) {
      this.mult *= this.cfg.ignoreBackoff;
      TD.Ads._emit('offer_ignore', { type: type });
    },

    rewardGranted: function (type) {
      if (type === 'skip') this.skipsUsed++;
      // a granted reward resets the pressure curve a little
      this.mult = Math.max(1, this.mult * 0.8);
      TD.Ads._emit('reward_granted', { type: type });
    }
  };

})(window.TD);
