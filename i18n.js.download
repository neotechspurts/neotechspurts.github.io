/* ============================================================
   Trap Dungeons 2 - i18n.js
   Tiny localization layer. Language is picked in this order:
   1. ?lang=it|en in the URL
   2. choice saved from a previous session
   3. the browser language (it* -> Italian, anything else English)
   Level names and tips live next to the level data as
   { it, en } objects and are resolved at render time, so
   switching language updates everything instantly.
   ============================================================ */
'use strict';

(function (TD) {

  var STRINGS = {
    en: {
      loading:  'LOADING...',
      pressAny: 'TAP OR PRESS ANY KEY',
      record:   'BEST',
      deaths:   'DEATHS',
      time:     'TIME',
      hearts:   'HEARTS',
      winTitle: 'YOU MADE IT!',
      backMenu: 'TAP TO RETURN TO THE MENU',
      winSkips: 'ROOMS SKIPPED',
      adTitle:  'STUCK?',
      adReveal: 'Watch a video to reveal this room\u2019s lies',
      adSkip:   'Watch a video to skip this room',
      adWatch:  'WATCH VIDEO',
      adNo:     'NO THANKS',
      adFail:   'No video available',
      adReward: 'REWARD UNLOCKED!',
      adMock:   'TEST AD',
      adClose:  'CLOSE AND CLAIM REWARD',
      adSkipX:  'Skip ad (no reward)',
      modeEasy:   'EASY',
      modeNormal: 'CLASSIC',
      modeHard:   'ONE LIFE',
      modeEasyDesc:   'Video helps: reveal the lies, skip rooms.',
      modeNormalDesc: 'Infinite lives. The counter judges you.',
      modeHardDesc:   'One death and back to the start.',
      menuHint:  'TAP A MODE TO PLAY',
      overTitle: 'GAME OVER',
      overRoom:  'REACHED',
      helpTitle: 'NEED A HAND?',
      helpNone:  'Nothing to help with here',
      adMockInter: 'ADVERTISEMENT (TEST)',
      focusHint: 'CLICK HERE TO ENABLE THE CONTROLS',
      modeEasyTag:   'video helps, reveal & skip',
      modeNormalTag: 'infinite lives, deaths count',
      modeHardTag:   'one death, back to start',
      tapUnlock:   'video',
      unlockTitle: 'Unlock this mode?',
      unlockEasy:  'Watch a video to unlock EASY',
      unlockHard:  'Watch a video to unlock ONE LIFE'
    },
    it: {
      loading:  'CARICAMENTO...',
      pressAny: 'TOCCA O PREMI UN TASTO',
      record:   'RECORD',
      deaths:   'MORTI',
      time:     'TEMPO',
      hearts:   'CUORI',
      winTitle: 'CE L\u2019HAI FATTA!',
      backMenu: 'TOCCA PER TORNARE AL MENU',
      winSkips: 'STANZE SALTATE',
      adTitle:  'BLOCCATO?',
      adReveal: 'Guarda un video per rivelare le bugie della stanza',
      adSkip:   'Guarda un video per saltare questa stanza',
      adWatch:  'GUARDA IL VIDEO',
      adNo:     'NO GRAZIE',
      adFail:   'Nessun video disponibile',
      adReward: 'PREMIO SBLOCCATO!',
      adMock:   'VIDEO DI PROVA',
      adClose:  'CHIUDI E RITIRA IL PREMIO',
      adSkipX:  'Salta il video (niente premio)',
      modeEasy:   'FACILE',
      modeNormal: 'CLASSICA',
      modeHard:   'UNA VITA',
      modeEasyDesc:   'Aiuti video: rivela le bugie, salta stanze.',
      modeNormalDesc: 'Vite infinite. Il contatore ti giudica.',
      modeHardDesc:   'Una morte e si ricomincia da capo.',
      menuHint:  'TOCCA UNA MODALITA\u0300 PER GIOCARE',
      overTitle: 'GAME OVER',
      overRoom:  'ARRIVATO A',
      helpTitle: 'SERVE UNA MANO?',
      helpNone:  'Niente da rivelare o saltare qui',
      adMockInter: 'ANNUNCIO (TEST)',
      focusHint: 'CLICCA QUI PER ATTIVARE I COMANDI',
      modeEasyTag:   'aiuti video, rivela e salta',
      modeNormalTag: 'vite infinite, conta le morti',
      modeHardTag:   'una morte, da capo',
      tapUnlock:   'video',
      unlockTitle: 'Sbloccare questa modalita\u0300?',
      unlockEasy:  'Guarda un video per sbloccare FACILE',
      unlockHard:  'Guarda un video per sbloccare UNA VITA'
    }
  };

  function detect() {
    try {
      var q = /[?&]lang=(it|en)\b/.exec(window.location.search || '');
      if (q) return q[1];
    } catch (e) { /* no location in odd embeds: fall through */ }
    var saved = TD.store.get('td2.lang', null);
    if (saved === 'it' || saved === 'en') return saved;
    var nav = ((navigator.language || navigator.userLanguage) || 'en').toLowerCase();
    return nav.indexOf('it') === 0 ? 'it' : 'en';
  }

  TD.I18N = {
    lang: 'en',

    init: function () {
      this.lang = detect();
      this._syncButton();
    },

    set: function (lang, persist) {
      this.lang = lang === 'it' ? 'it' : 'en';
      if (persist !== false) TD.store.set('td2.lang', this.lang);
      this._syncButton();
    },

    toggle: function () {
      this.set(this.lang === 'it' ? 'en' : 'it');
    },

    _syncButton: function () {
      var b = document.getElementById('lang-btn');
      if (b) b.textContent = this.lang.toUpperCase();
    }
  };

  // UI string lookup with English fallback.
  TD.t = function (key) {
    var table = STRINGS[TD.I18N.lang] || STRINGS.en;
    return table[key] != null ? table[key] : (STRINGS.en[key] != null ? STRINGS.en[key] : key);
  };

  // Level field lookup: accepts { it, en } objects or plain strings.
  TD.tr = function (field) {
    if (field == null) return '';
    if (typeof field === 'string') return field;
    return field[TD.I18N.lang] || field.en || field.it || '';
  };

})(window.TD);
